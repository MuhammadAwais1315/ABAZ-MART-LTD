# ==========================================
# ABAZ MART - ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# 1. Supabase (Database & Authentication)
# The public client automatically proxies through your domain's /db-gateway
# so that the direct Supabase URL is completely masked from browser traffic.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Direct Supabase URL (defaults to your project gateway /db-gateway)
# Set VITE_USE_DB_PROXY=false only if you want direct connections bypassing the proxy.
VITE_SUPABASE_URL=https://twstiotnaaglptizaxkm.supabase.co
VITE_USE_DB_PROXY=true

# 2. Stripe (Card & Digital Wallet Payments)
# Client-side publishable key (starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Serverless secret key (starts with sk_test_ or sk_live_) - NEVER exposed to browser
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# 3. Resend (Order Confirmation & Dispatch Notification Emails)
# Serverless secret key (starts with re_) - NEVER exposed to browser
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender address on your abazmart.co.uk domain
RESEND_FROM_EMAIL=Abaz Mart <orders@abazmart.co.uk>
