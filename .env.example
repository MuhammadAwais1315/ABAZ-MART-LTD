# ==========================================
# ABAZ MART - ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# 1. Supabase (Database & Authentication)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Stripe (Card & Digital Wallet Payments)
# Client-side publishable key (starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Serverless secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# 3. Resend (Order Confirmation Emails & Receipts)
# Get your API key for free at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: Custom verified sender (e.g., "Abaz Mart <orders@abazmart.co.uk>")
# If omitted or left empty, defaults to "Abaz Mart <onboarding@resend.dev>" for instant sandbox testing
RESEND_FROM_EMAIL=Abaz Mart <orders@abazmart.co.uk>
